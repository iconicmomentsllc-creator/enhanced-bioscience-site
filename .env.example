# Copy to .env.local (never commit real secrets).

# Database — PostgreSQL only (Neon, Supabase, RDS, local Docker, etc.). Do not use SQLite
# or `file:...` URLs; migrations and Prisma Client expect PostgreSQL.
# Example Neon: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/enhanced_bioscience?schema=public"

# Auth — generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Membership access code — must match what you send members after they request access (required to create an account)
# MEMBER_ACCESS_CODE=EBS2026

# Where access-request form emails are delivered (defaults to enhancedbioscience@gmail.com)
# ACCESS_REQUEST_TO=you@example.com

# SMTP — required for /request-access to send mail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Enhanced Bioscience <youraddress@gmail.com>"

# PrescribeRx — server-side only. Never use NEXT_PUBLIC_ for these.
# PRESCRIBERX_ENVIRONMENT must be "sandbox" or "production".
# Base URL is read from env (do not hard-code hosts in app logic).
# Sandbox API root: https://demo.prescribe-rx.com/api/v1
# Production API root: https://prescribe-rx.com/api/v1
# PRESCRIBERX_ENVIRONMENT=sandbox
# PRESCRIBERX_BASE_URL=https://demo.prescribe-rx.com/api/v1
# PRESCRIBERX_TOKEN=
#
# Production identity: a Client (preferred) or Sales Organization token with
# product:read, patient:read/create/update, telehealth:read/submit,
# encounter:read/create/update, order:read/create/update, prescription:read,
# webhook:read/create/update/delete. Do not use system_admin / super_admin.
#
# After the public site URL exists:
#   node scripts/setup-prescriberx-webhook.mjs
# Then store the printed signing secret here (never commit it):
# PRESCRIBERX_WEBHOOK_SECRET=
#
# Optional. UUID of the PrescribeRx merchant account for the same external gateway.
# Without this, charges can still be recorded as reference_captured but refill/rebill
# is NOT enabled.
# PRESCRIBERX_MERCHANT_ACCOUNT_ID=
#
# External Enhanced Bioscience gateway (never payment.mode=authorize).
# PRESCRIBERX_PAYMENT_GATEWAY=stripe
# PRESCRIBERX_PAYMENT_MODE=reference_captured
#
# Stripe (live charge path implemented). Required to actually charge:
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# (Browser uses the publishable key only to tokenize a card; amounts are set server-side.)
#
# Authorize.Net / NMI / Square credentials (vault formats supported in the payment
# block). Live capture adapters for these gateways still require the owner to supply:
# AUTHORIZE_NET_API_LOGIN_ID=
# AUTHORIZE_NET_TRANSACTION_KEY=
# AUTHORIZE_NET_ENDPOINT=
# NMI_SECURITY_KEY=
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=

# Production: set NEXTAUTH_URL to your public https URL.
#
# Migrations: `npm run build` does NOT connect to the DB (so Vercel builds succeed even if Neon
# is asleep or flaky). After deploy or from CI, run once with DATABASE_URL set:
#   npx prisma migrate deploy
#   # or: npm run migrate:deploy
# Neon: use the connection string from the dashboard; add ?sslmode=require if not present. If
# builds/runtime still cannot connect, wake the project in Neon and try the pooled/hosted URL.
